# Server-only email delivery settings. Never expose these through VITE_ variables.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=

# Optional. Enquiries go to this address when the variable is omitted or empty.
ENQUIRY_TO_EMAIL=Info.translinelogistics@gmail.com

# Browser-safe admin portal settings. Also add both to Vercel's project
# environment variables for Production and Preview, then redeploy.
# Local portal development reads portal/.env.local (see its example file).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
